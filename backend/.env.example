# =============================================================================
# Fail2Pay — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The application will fail fast at startup if mandatory keys are missing.
# =============================================================================

# --- Database (required) ---
# PostgreSQL connection string (e.g. Neon, Supabase, local Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/fail2pay

# --- API Authentication (optional) ---
# Set to enable Bearer token auth on all private /api/* endpoints.
# Leave empty to disable (development mode). Webhooks are always public.
API_KEY=

# --- Razorpay (required for payment processing) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- AI Intent Detection (optional — falls back to rule-based if unset) ---
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
AI_CONFIDENCE_THRESHOLD=0.6

# --- WhatsApp Cloud API (required for WhatsApp messaging) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Email (required for email recovery) ---
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@fail2pay.com

# --- Application ---
PAYMENT_LINK_BASE_URL=https://fail2pay.example.com
PROMISE_HIGH_VALUE_THRESHOLD_PAISE=1000000
